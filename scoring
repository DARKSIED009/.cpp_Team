"""
ShadowCredit Scoring Engine
Behavioral credit scoring for gig economy workers.

Score Components (total = 1000):
- Income Stability       25% (250 pts)
- Work Consistency       20% (200 pts)
- Platform Reputation    20% (200 pts)
- Activity Longevity     10% (100 pts)
- Reliability            10% (100 pts)
- Financial Discipline   10% (100 pts)
- Growth Trend            5% ( 50 pts)
"""

import numpy as np
from typing import Dict, Any


def calculate_score(worker_data: Dict[str, Any]) -> Dict[str, Any]:
    """Calculate behavioral credit score from worker profile data."""
    incomes = np.array(worker_data["monthly_incomes"], dtype=float)
    completed = float(worker_data["completed_jobs"])
    cancellations = float(worker_data["cancellations"])
    rating = float(worker_data["rating"])
    months_active = int(worker_data["months_active"])
    account_age_months = int(worker_data.get("account_age_months", months_active))
    active_months_last_year = int(worker_data.get("active_months_last_year", min(months_active, 12)))

    # ── 1. Income Stability (25%) ─────────────────────────────────────────
    mean_income = np.mean(incomes)
    std_income = np.std(incomes)
    cv = std_income / mean_income if mean_income > 0 else 1.0
    income_stability = max(0.0, 1.0 - min(cv, 1.0))

    # ── 2. Work Consistency (20%) ─────────────────────────────────────────
    # Ratio of active months to account age (up to 12 for last year)
    consistency = min(active_months_last_year / 12.0, 1.0)

    # ── 3. Platform Reputation (20%) ──────────────────────────────────────
    # Normalize 1.0–5.0 rating to 0–1, with 1.0 as minimum baseline
    reputation = max(0.0, (rating - 1.0) / 4.0)

    # ── 4. Activity Longevity (10%) ───────────────────────────────────────
    # Benchmark: 48 months = 4 years of platform activity
    longevity = min(account_age_months / 48.0, 1.0)

    # ── 5. Reliability (10%) ─────────────────────────────────────────────
    total_jobs = completed + cancellations
    reliability = completed / total_jobs if total_jobs > 0 else 0.0

    # ── 6. Financial Discipline Proxy (10%) ──────────────────────────────
    # Proxy: average of (consistency of income vs expenses not tracked)
    # Use income growth quarter-over-quarter as a proxy for discipline
    if len(incomes) >= 6:
        q1 = np.mean(incomes[:3])
        q2 = np.mean(incomes[3:6])
        q3 = np.mean(incomes[6:9]) if len(incomes) >= 9 else q2
        q4 = np.mean(incomes[9:12]) if len(incomes) >= 12 else q3
        quarters = [q1, q2, q3, q4]
        # No declining quarters = disciplined
        no_decline_quarters = sum(1 for i in range(1, len(quarters)) if quarters[i] >= quarters[i-1])
        discipline = no_decline_quarters / (len(quarters) - 1)
    else:
        discipline = 0.5  # neutral when insufficient data

    # ── 7. Growth Trend (5%) ─────────────────────────────────────────────
    if len(incomes) >= 4:
        first_half_avg = np.mean(incomes[:len(incomes)//2])
        second_half_avg = np.mean(incomes[len(incomes)//2:])
        growth = second_half_avg / first_half_avg if first_half_avg > 0 else 1.0
        # Normalize: 1.0 = flat (0.5 score), 1.5+ = excellent (1.0 score), <0.7 = poor (0.0)
        growth_score = np.clip((growth - 0.7) / 0.8, 0.0, 1.0)
    else:
        growth_score = 0.5

    # ── Weighted Score ────────────────────────────────────────────────────
    weights = {
        "income_stability": 0.25,
        "work_consistency": 0.20,
        "platform_reputation": 0.20,
        "activity_longevity": 0.10,
        "reliability": 0.10,
        "financial_discipline": 0.10,
        "growth_trend": 0.05,
    }

    factors = {
        "income_stability": income_stability,
        "work_consistency": consistency,
        "platform_reputation": reputation,
        "activity_longevity": longevity,
        "reliability": reliability,
        "financial_discipline": discipline,
        "growth_trend": growth_score,
    }

    raw_score = sum(weights[k] * factors[k] for k in weights)
    final_score = round(min(1000, max(0, raw_score * 1000)))

    # ── Risk Band ─────────────────────────────────────────────────────────
    if final_score >= 800:
        risk_band = "Excellent"
        risk_color = "#10b981"
    elif final_score >= 650:
        risk_band = "Good"
        risk_color = "#14b8a6"
    elif final_score >= 500:
        risk_band = "Fair"
        risk_color = "#f59e0b"
    else:
        risk_band = "High Risk"
        risk_color = "#ef4444"

    # ── Loan Eligibility ──────────────────────────────────────────────────
    loan_multiplier = {
        "Excellent": 8,
        "Good": 5,
        "Fair": 3,
        "High Risk": 0,
    }
    avg_monthly = float(np.mean(incomes))
    estimated_loan = round(avg_monthly * loan_multiplier[risk_band])

    # ── Recommendations ───────────────────────────────────────────────────
    recommendations = generate_recommendations(factors, final_score, cancellations, total_jobs)

    # ── Risk Signals ──────────────────────────────────────────────────────
    risk_signals = generate_risk_signals(factors, incomes, cancellations, total_jobs, rating)

    return {
        "score": final_score,
        "risk_band": risk_band,
        "risk_color": risk_color,
        "avg_monthly_income": round(avg_monthly, 2),
        "income_volatility": round(cv * 100, 1),
        "estimated_loan_eligibility": estimated_loan,
        "factors": {k: round(v * 100, 1) for k, v in factors.items()},
        "factor_scores": {k: round(v * weights[k] * 1000) for k, v in factors.items()},
        "recommendations": recommendations,
        "risk_signals": risk_signals,
    }


def generate_recommendations(factors: Dict, score: int, cancellations: float, total_jobs: float) -> list:
    recs = []
    if factors["income_stability"] < 0.6:
        recs.append({
            "title": "Reduce income volatility",
            "detail": "Try maintaining consistent working hours across months to stabilize your earnings pattern.",
            "impact": "High",
            "icon": "📈"
        })
    if factors["work_consistency"] < 0.7:
        recs.append({
            "title": "Increase monthly activity",
            "detail": "Take at least 20 rides/deliveries per month consistently to improve your Work Consistency score.",
            "impact": "High",
            "icon": "📅"
        })
    if factors["platform_reputation"] < 0.75:
        recs.append({
            "title": "Improve customer rating",
            "detail": "A rating above 4.5 unlocks significant score improvements. Focus on service quality.",
            "impact": "Medium",
            "icon": "⭐"
        })
    if factors["reliability"] < 0.9 and total_jobs > 0:
        cancel_rate = round((cancellations / total_jobs) * 100, 1)
        recs.append({
            "title": f"Reduce cancellation rate (currently {cancel_rate}%)",
            "detail": "Aim for a cancellation rate below 5% to maximize reliability score.",
            "impact": "Medium",
            "icon": "✅"
        })
    if factors["activity_longevity"] < 0.5:
        recs.append({
            "title": "Build longer platform history",
            "detail": "Accounts with 2+ years of history receive significantly higher longevity scores.",
            "impact": "Low",
            "icon": "🕐"
        })
    if factors["growth_trend"] < 0.4:
        recs.append({
            "title": "Work towards income growth",
            "detail": "Increase earnings each quarter — even 10% growth shows positive financial trajectory.",
            "impact": "Medium",
            "icon": "🚀"
        })
    if not recs:
        recs.append({
            "title": "Excellent profile! Maintain consistency",
            "detail": "Your behavioral credit profile is strong. Keep up the consistent performance.",
            "impact": "Low",
            "icon": "🏆"
        })
    return recs


def generate_risk_signals(factors, incomes, cancellations, total_jobs, rating) -> list:
    signals = []
    import numpy as np
    cv = np.std(incomes) / np.mean(incomes) if np.mean(incomes) > 0 else 1
    if cv > 0.5:
        signals.append({"type": "warning", "text": "High income volatility detected (>50% variance)"})
    if rating < 4.0:
        signals.append({"type": "danger", "text": f"Below-average rating ({rating}/5.0)"})
    if total_jobs > 0 and cancellations / total_jobs > 0.12:
        signals.append({"type": "danger", "text": f"High cancellation rate ({round(cancellations/total_jobs*100, 1)}%)"})
    if factors["work_consistency"] < 0.5:
        signals.append({"type": "warning", "text": "Irregular work pattern — less than 6 active months/year"})
    if factors["activity_longevity"] < 0.25:
        signals.append({"type": "info", "text": "New account — limited track record"})
    if not signals:
        signals.append({"type": "success", "text": "No major risk signals detected"})
    return signals


def simulate_score(worker_data: Dict, adjustments: Dict) -> Dict:
    """Recalculate score with hypothetical adjustments for simulator."""
    import copy
    simulated = copy.deepcopy(worker_data)

    # Apply rating adjustment
    if "rating_delta" in adjustments:
        simulated["rating"] = max(1.0, min(5.0, simulated["rating"] + adjustments["rating_delta"]))

    # Apply cancellation reduction (% reduction)
    if "cancellation_reduction_pct" in adjustments:
        reduction = adjustments["cancellation_reduction_pct"] / 100.0
        simulated["cancellations"] = round(simulated["cancellations"] * (1 - reduction))

    # Apply income volatility reduction (flatten incomes)
    if "volatility_reduction_pct" in adjustments:
        reduction = adjustments["volatility_reduction_pct"] / 100.0
        mean_i = np.mean(simulated["monthly_incomes"])
        flat = np.array(simulated["monthly_incomes"])
        flat = flat + (mean_i - flat) * reduction
        simulated["monthly_incomes"] = flat.tolist()

    return calculate_score(simulated)

